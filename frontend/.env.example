# Frontend environment template. Copy to .env.development.local / .env.production.local (git-ignored) as needed.
#
# REACT_APP_API_URL: origin of the Express backend (no trailing /api), only when the frontend is hosted on a different
# origin than the backend, e.g. https://api.example.com. Leave unset to use same-origin /api.
# Local development (npm start) needs nothing here: requests to /api are proxied to http://localhost:5000 (package.json).
# Never put secrets in REACT_APP_ variables: they are embedded in the public JavaScript bundle.
REACT_APP_API_URL=
