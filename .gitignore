# ── Credentials & Secrets ──────────────────────────────────
backend/.env
frontend/.env
frontend/.env.local
frontend/.env.production
frontend/.env.development
*.env
.env.*
# Templates with placeholder values only — safe and useful to track
!.env.example

# ── Dependencies ────────────────────────────────────────────
node_modules/
backend/node_modules/
frontend/node_modules/

# ── Build Output ────────────────────────────────────────────
frontend/build/
frontend/dist/

# ── Logs ────────────────────────────────────────────────────
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
logs/

# ── OS Files ────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ── Editor ──────────────────────────────────────────────────
.vscode/settings.json
.idea/
*.suo
*.user

# ── Database backups (contain real patient data) ────────────
backups/

# ── Python / ML service ─────────────────────────────────────
__pycache__/
*.pyc
.venv/
ml_service/artifacts/*
!ml_service/artifacts/.gitkeep
# Generated data: reproducible from training/generate_synthetic.py (seed in manifest.json)
ml_service/datasets/**/*.csv

# ── Misc ────────────────────────────────────────────────────
*.pem
*.key
*.cert
*.p12
