DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password_here
DB_NAME=fraud_detection
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRES_IN=24h
PORT=5000

# Phase 4.4: internal ML service (FastAPI). The same ML_API_KEY must be set for the ML service.
# The key stays on the server: it is never sent to the browser.
ML_ENABLED=true
ML_SERVICE_URL=http://127.0.0.1:8000
ML_API_KEY=generate_a_long_random_value_here
ML_TIMEOUT_MS=3000
ML_CIRCUIT_FAILURES=3
ML_CIRCUIT_COOLDOWN_MS=30000
ML_INDICATOR_SET_KEY=app-indicators-v2

# AI endpoint rate limits (/api/ai only; requests per user per window; existing routes are not limited)
AI_RATE_LIMIT_ENABLED=true
AI_RATE_WINDOW_MS=60000
AI_RATE_COMPUTE_PER_USER=60
AI_RATE_RECOMPUTE_PER_USER=10
AI_RATE_OUTCOME_PER_USER=30
AI_RATE_READ_PER_USER=120
AI_RATE_COMPUTE_GLOBAL=600
